POSTGRES_DB=housing_intelligence
POSTGRES_USER=housing_app
POSTGRES_PASSWORD=replace_me
POSTGRES_HOST_PORT=5433

# All clients, including Alembic, use the components above. DATABASE_URL is unused.
POSTGRES_HOST=localhost
# GDAL >=3.7 with OpenFileGDB and PostgreSQL drivers; executable paths also work.
OGRINFO_EXECUTABLE=ogrinfo
OGR2OGR_EXECUTABLE=ogr2ogr
# Optional: PROJ data directory belonging to the chosen GDAL installation.
# GDAL_PROJ_DATA=C:/Program Files/QGIS 3.44.12/share/proj
